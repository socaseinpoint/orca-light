#!/usr/bin/env python3
"""orca — lightweight session continuity for Claude Code.

Files are state. Views are derived on read. One writer per file. No locks,
no lifecycle flips, no scheduler, no shared mutable state, no global state.

orca lives entirely in `<project>/.orca/`, like `.git/`. The binary is global
(one symlink on PATH); the STATE is project-local. There is no cross-project
concept in the core — no registry, no `~/.orca`, no "resolve from anywhere".
A cross-project overview, if ever wanted, is an external add-on that scans
`.orca/` files; orca core never learns about it.

Topology (all views derived on read, nothing derived is stored):

  <project>/.orca/
    <NN-name>/            an in-work FOCUS — the atom of orca, a self-contained
      focus.md             campaign: intent + done-when + Now + arks + Trail + Log
      decisions.md         focus-scoped why-ledger (append-only)
      arks/
        <slug>.md          an in-work ARK — a deliverable under the focus
        done/<slug>.md     a done ark (location is the terminal truth)
    done/
      <NN-name>/           a done focus (the whole dir moved here)

Two states, expressed by FOLDER LOCATION, never a `state:` flip:
  in-work focus  .orca/<name>/        done focus  .orca/done/<name>/
  in-work ark    <focus>/arks/<slug>  done ark    <focus>/arks/done/<slug>

The trust foundation is `orca verify`: a handoff is not faith-based prose, it
is claims + checkable anchors. Anchors live on `done:` lines under `## Trail`.
If an anchor is fake, verify fails. Confabulated continuity gets caught here
instead of silently poisoning the next session.

Anchors (inline on `done:` lines):
  [file:PATH:LINE]   -> PATH exists and has >= LINE lines
  [commit:HASH]      -> HASH resolves to a commit in this repo
  [test:COMMAND]     -> COMMAND re-runs with exit 0 (skipped with --no-tests)

Usage:
  orca init                      scaffold project .orca/
  orca now                       resume: every in-work focus + open arks + where you stopped
  orca verify [FILE] [--no-tests]  check a handoff's Trail anchors against reality
  orca decide "<what> — <why>"   append a decision to the focus's decisions.md
  orca trail <slug>              one focus's (or ark's) Trail, oldest->newest
  orca done <slug>               finish an ark (-> arks/done/ + Log line) or a focus (-> .orca/done/)
  orca gate                      warn (exit 1) if the freshest focus's latest Trail block isn't verified
  orca session record|pending|compressed|prune   session-context ledger (makes resume live-aware)

The session ledger (the MUST-tier correctness layer): the SessionStart hook records
each session's id + EXACT transcript path + cwd under .orca/sessions/ (ephemeral,
gitignored). `orca session pending` then tells resume which prior transcripts are
SAFE to compress — excluding the current session, any LIVE concurrent one, already
-folded sessions, and other projects — so resume folds the SET exactly once, never
partially compresses a live transcript, and finds transcripts without guessing paths.
"""
import argparse
import glob
import json
import os
import re
import subprocess
import sys
import time

ANCHOR_RE = re.compile(r"\[(file|commit|test):([^\]]+)\]")
TRAIL_HEADING_RE = re.compile(r"^#{1,6}\s+(trail|sessions|handoff)\b", re.IGNORECASE)
HEADING_RE = re.compile(r"^(#{1,6})\s")
BULLET_RE = re.compile(r"^\s*[-*]\s+\S")
DONE_RE = re.compile(r"^\s*done:\s*\S", re.IGNORECASE)
DONE_CLAIM_RE = re.compile(r"^\s*done:\s*(.+)$", re.IGNORECASE)

GREEN, RED, YELLOW, DIM, RESET = "\033[32m", "\033[31m", "\033[33m", "\033[2m", "\033[0m"


def _c(color, text):
    return text if not sys.stdout.isatty() else color + text + RESET


def find_repo_root(start):
    """Nearest ancestor holding .orca/, else git toplevel, else start."""
    cur = os.path.abspath(start)
    while True:
        if os.path.isdir(os.path.join(cur, ".orca")):
            return cur
        parent = os.path.dirname(cur)
        if parent == cur:
            break
        cur = parent
    try:
        out = subprocess.run(
            ["git", "rev-parse", "--show-toplevel"],
            cwd=start, capture_output=True, text=True, check=True,
        )
        return out.stdout.strip()
    except (subprocess.CalledProcessError, FileNotFoundError):
        return os.path.abspath(start)


# --- anchor checks: orca's deterministic core (evidence is reality, not prose) ---

def check_file(payload, root):
    if ":" not in payload:
        return False, "no :LINE in anchor"
    path, _, line_s = payload.rpartition(":")
    try:
        line = int(line_s)
    except ValueError:
        return False, "line not an int: %r" % line_s
    abs_path = path if os.path.isabs(path) else os.path.join(root, path)
    if not os.path.isfile(abs_path):
        return False, "file not found: %s" % path
    with open(abs_path, "r", errors="replace") as fh:
        n = sum(1 for _ in fh)
    if line < 1 or line > n:
        return False, "line %d out of range (file has %d)" % (line, n)
    return True, "%s:%d ok" % (path, line)


def check_commit(payload, root):
    h = payload.strip()
    try:
        out = subprocess.run(
            ["git", "rev-parse", "--verify", "--quiet", h + "^{commit}"],
            cwd=root, capture_output=True, text=True,
        )
    except FileNotFoundError:
        return False, "git not available"
    if out.returncode != 0 or not out.stdout.strip():
        return False, "no such commit: %s" % h
    return True, "commit %s" % out.stdout.strip()[:12]


def check_test(payload, root, timeout):
    cmd = payload.strip()
    try:
        out = subprocess.run(
            cmd, cwd=root, shell=True, capture_output=True, text=True,
            timeout=timeout,
        )
    except subprocess.TimeoutExpired:
        return False, "timed out after %ss" % timeout
    if out.returncode != 0:
        tail = (out.stderr or out.stdout or "").strip().splitlines()
        tail = tail[-1] if tail else ""
        return False, "exit %d: %s" % (out.returncode, tail[:80])
    return True, "exit 0"


# --- claim<->evidence judging: pluggable, OFF by default; deterministic core stays ---

def _truncate(s, n):
    s = s or ""
    return s if len(s) <= n else s[:n] + "\n…[truncated]"


def evidence_for(kind, payload, root, timeout):
    """A receipt: the real artifact behind an anchor, rendered as text a judge reads."""
    if kind == "commit":
        out = subprocess.run(["git", "show", "--stat", "-p", payload.strip()],
                             cwd=root, capture_output=True, text=True)
        return _truncate(out.stdout, 3000) if out.returncode == 0 else "(commit not found)"
    if kind == "file":
        path, _, line_s = payload.rpartition(":")
        try:
            line = int(line_s)
        except ValueError:
            return "(bad file anchor)"
        abs_path = path if os.path.isabs(path) else os.path.join(root, path)
        if not os.path.isfile(abs_path):
            return "(file not found)"
        with open(abs_path, "r", errors="replace") as fh:
            rows = fh.readlines()
        lo, hi = max(0, line - 4), min(len(rows), line + 3)
        return "%s lines %d-%d:\n%s" % (path, lo + 1, hi, _truncate("".join(rows[lo:hi]), 1500))
    if kind == "test":
        try:
            out = subprocess.run(payload.strip(), cwd=root, shell=True,
                                 capture_output=True, text=True, timeout=timeout)
        except subprocess.TimeoutExpired:
            return "(test timed out)"
        body = (out.stdout or "") + (out.stderr or "")
        return "exit %d\n%s" % (out.returncode, _truncate(body, 1500))
    return ""


def iter_done_claims(text):
    """Each provable claim + its anchors: `done:` lines in the Trail zone.
    The orient zone (why/next/head) is intent — never judged."""
    claims, in_zone = [], False
    for raw in text.splitlines():
        m = HEADING_RE.match(raw)
        if m and len(m.group(1)) <= 2:
            in_zone = bool(TRAIL_HEADING_RE.match(raw))
            continue
        if m:
            continue
        anchors = ANCHOR_RE.findall(raw)
        if not anchors or not in_zone:
            continue
        dm = DONE_CLAIM_RE.match(raw)
        if dm:
            claims.append((dm.group(1).strip(), anchors))
        elif BULLET_RE.match(raw):  # legacy handoff bullets
            claims.append((raw.strip().lstrip("-* ").strip(), anchors))
    return claims


def judge_claim(claim, evidence, timeout):
    """Ask a SEPARATE cheap model whether the evidence substantiates the claim.
    Pluggable via ORCA_JUDGE_CMD (default: Claude Haiku). Unavailable judge =
    skipped (grounded), so the deterministic core never depends on it."""
    cmd = os.environ.get("ORCA_JUDGE_CMD", "claude -p --model claude-haiku-4-5")
    prompt = (
        "You are a STRICT grader. Decide if the EVIDENCE substantiates the CLAIM.\n"
        "The evidence is real (git/files/tests). Be skeptical: if it does not clearly\n"
        "show the claimed work, answer NO. A passing test or an existing commit that is\n"
        "UNRELATED to the claim is NOT support.\n"
        "First word must be YES or NO, then one short reason.\n\n"
        "CLAIM: %s\n\nEVIDENCE:\n%s\n" % (claim, evidence)
    )
    try:
        out = subprocess.run(cmd, shell=True, input=prompt,
                             capture_output=True, text=True, timeout=timeout)
    except (subprocess.TimeoutExpired, FileNotFoundError):
        return True, "judge unavailable (skipped)"
    resp = (out.stdout or "").strip()
    if out.returncode != 0 or not resp:
        return True, "judge unavailable (skipped)"
    words = resp.split()
    grounded = not words[0].upper().strip(".:,").startswith("NO")
    reason = " ".join(words[1:])[:100] if len(words) > 1 else resp[:100]
    return grounded, reason


def judge_pass(text, root, timeout):
    """Returns (ok, lines) — UNGROUND for each done: claim the judge can't substantiate."""
    lines, ok = [], True
    for claim, anchors in iter_done_claims(text):
        evidence = "\n---\n".join(evidence_for(k, p, root, timeout) for k, p in anchors)
        grounded, reason = judge_claim(claim, evidence, timeout)
        lines.append((("GROUND" if grounded else "UNGROUND"),
                      "%s — %s" % (claim[:60], reason)))
        ok = ok and grounded
    return ok, lines


def proven_lines(text):
    """Lines in the proven zone — `done:` lines (and legacy handoff bullets) under
    `## Trail`. Anchors are checked ONLY here. Prose in Now/why/next/head/decisions
    may quote `[test:...]` freely without verify trying to run it."""
    out, in_zone = [], False
    for raw in text.splitlines():
        m = HEADING_RE.match(raw)
        if m and len(m.group(1)) <= 2:
            in_zone = bool(TRAIL_HEADING_RE.match(raw))
            continue
        if m:
            continue
        if in_zone and (DONE_RE.match(raw) or BULLET_RE.match(raw)):
            out.append(raw)
    return "\n".join(out)


def bare_claims(text):
    """Unproven claims in the proven zone: a `done:` line (or legacy bullet) under
    `## Trail` that carries no anchor. why/next/head are the orient zone and are
    never flagged. A `###` date subheading does not close the zone; only a new
    top-level heading does."""
    flagged, in_zone = [], False
    for raw in text.splitlines():
        m = HEADING_RE.match(raw)
        if m and len(m.group(1)) <= 2:
            in_zone = bool(TRAIL_HEADING_RE.match(raw))
            continue
        if m:
            continue
        if ANCHOR_RE.search(raw):
            continue
        if in_zone and (DONE_RE.match(raw) or BULLET_RE.match(raw)):
            flagged.append(raw.strip())
    return flagged


def check_anchors(text, root, no_tests, timeout):
    """Core check. Returns (ok, lines, n_anchors). Pure — no printing."""
    anchors = ANCHOR_RE.findall(proven_lines(text))
    lines, ok = [], True
    if not anchors:
        lines.append(("NONE", "no anchors found — handoff is unproven prose"))
    for kind, payload in anchors:
        if kind == "file":
            passed, msg = check_file(payload, root)
        elif kind == "commit":
            passed, msg = check_commit(payload, root)
        else:  # test
            if no_tests:
                lines.append(("SKIP", "[test:%s] (--no-tests)" % payload))
                continue
            passed, msg = check_test(payload, root, timeout)
        lines.append(("OK" if passed else "FAIL", "[%s:%s] %s" % (kind, payload, msg)))
        ok = ok and passed
    for b in bare_claims(text):
        lines.append(("BARE", b[:90]))
        ok = False
    return ok, lines, len(anchors)


_TAG = {"OK": (GREEN, " OK "), "FAIL": (RED, "FAIL"), "SKIP": (YELLOW, "SKIP"),
        "BARE": (YELLOW, "BARE"), "NONE": (YELLOW, "----"),
        "GROUND": (GREEN, "GRND"), "UNGROUND": (RED, "UNGR")}


# --- topology: project-local focuses + arks, all derivation on read ---

FIELD_RE = re.compile(r"([A-Za-z][\w-]*):\s*(.*)$")


def parse_fields(text):
    """Leading `key: value` block (after the title heading, before first section)."""
    fields = {}
    for raw in text.splitlines():
        s = raw.strip()
        if s.startswith("#"):
            continue
        if not s:
            if fields:
                break
            continue
        m = FIELD_RE.match(s)
        if m:
            fields[m.group(1).lower()] = m.group(2).strip()
        elif fields:
            break
    return fields


def section_bullets(text, name):
    """Bullets under `## <name>`."""
    out, in_sec = [], False
    head = re.compile(r"^#{1,6}\s+" + re.escape(name) + r"\b", re.IGNORECASE)
    for raw in text.splitlines():
        if raw.startswith("#"):
            in_sec = bool(head.match(raw))
            continue
        if in_sec and BULLET_RE.match(raw):
            out.append(raw.strip().lstrip("-* ").strip())
    return out


def section_text(text, name):
    """Raw body lines under `## <name>` (until the next top-level heading), stripped
    of leading HTML comments and blank padding. Used to surface a focus's `## Now`."""
    out, in_sec = [], False
    head = re.compile(r"^#{1,6}\s+" + re.escape(name) + r"\b", re.IGNORECASE)
    for raw in text.splitlines():
        m = HEADING_RE.match(raw)
        if m:
            in_sec = bool(head.match(raw))
            continue
        if in_sec:
            out.append(raw)
    while out and not out[0].strip():
        out.pop(0)
    while out and not out[-1].strip():
        out.pop()
    return [l for l in out if not l.strip().startswith("<!--")]


def _load_doc(path):
    with open(path, "r", errors="replace") as fh:
        text = fh.read()
    return {
        "slug": os.path.splitext(os.path.basename(path))[0],
        "path": path, "text": text, "fields": parse_fields(text),
        "mtime": os.path.getmtime(path),
    }


def iter_focuses(root, include_done=False):
    """In-work focuses: child dirs of .orca/ holding a focus.md (excluding done/).
    Freshest first by mtime. Done focuses live under .orca/done/<name>/."""
    base = os.path.join(root, ".orca")
    focuses = []
    if os.path.isdir(base):
        for name in os.listdir(base):
            if name == "done":
                continue
            fpath = os.path.join(base, name, "focus.md")
            if os.path.isfile(fpath):
                d = _load_doc(fpath)
                d["slug"], d["dir"] = name, os.path.join(base, name)
                d["mtime"] = os.path.getmtime(fpath)
                focuses.append(d)
        if include_done:
            for fpath in glob.glob(os.path.join(base, "done", "*", "focus.md")):
                d = _load_doc(fpath)
                d["slug"] = os.path.basename(os.path.dirname(fpath))
                d["dir"] = os.path.dirname(fpath)
                focuses.append(d)
    focuses.sort(key=lambda d: d["mtime"], reverse=True)
    return focuses


def focus_arks(focus_dir, include_done=False):
    """Arks under a focus: arks/*.md flat (in-work). Done arks live in arks/done/."""
    adir = os.path.join(focus_dir, "arks")
    arks = []
    for f in glob.glob(os.path.join(adir, "*.md")):
        arks.append(_load_doc(f))
    if include_done:
        for f in glob.glob(os.path.join(adir, "done", "*.md")):
            d = _load_doc(f)
            d["_done"] = True
            arks.append(d)
    arks.sort(key=lambda d: d["mtime"], reverse=True)
    return arks


def find_ark(root, slug):
    """Resolve <slug> to (ark_doc, focus_doc, is_done) across all focuses (in-work
    and done), live ark before done ark. Returns (None, None, None) if not found."""
    for focus in iter_focuses(root, include_done=True):
        for include_done in (False, True):
            for a in focus_arks(focus["dir"], include_done=include_done):
                if a["slug"] == slug:
                    return a, focus, bool(a.get("_done"))
    return None, None, None


def all_sessions(text):
    """Every `### ` block under `## Trail`, in file order (newest LAST by convention):
    date + done/why/next/head. Multiple done: lines in a block are joined."""
    blocks, cur, in_zone = [], None, False
    for raw in text.splitlines():
        m = HEADING_RE.match(raw)
        if m and len(m.group(1)) <= 2:
            if cur:
                blocks.append(cur)
                cur = None
            in_zone = bool(TRAIL_HEADING_RE.match(raw))
            continue
        if not in_zone:
            continue
        if m:  # ### date subheading -> new block
            if cur:
                blocks.append(cur)
            dm = re.match(r"^#{3,6}\s+(.+)$", raw)
            cur = {"date": dm.group(1).strip() if dm else "?"}
            continue
        if cur is not None:
            fm = re.match(r"^\s*(done|why|next|head):\s*(.+)$", raw, re.IGNORECASE)
            if fm:
                k, v = fm.group(1).lower(), fm.group(2).strip()
                cur[k] = (cur[k] + "; " + v) if cur.get(k) else v
    if cur:
        blocks.append(cur)
    return blocks


def latest_session(text):
    blocks = all_sessions(text)
    return blocks[-1] if blocks else {}


def latest_handoff_text(text):
    """The freshest handoff to verify: the LAST `### ` block under `## Trail` (or the
    whole zone if it has none, e.g. legacy bullet handoffs), re-wrapped under a
    `## Trail` heading so the zone-scoped parsers see it. An accumulating Trail can't
    keep every historical file:line anchor green as files move/grow; verify proves the
    CURRENT handoff. Commit anchors are immutable, so they stay green forever — which
    is why they're the durable choice for a claim you want to survive."""
    in_zone = False
    blocks = [[]]  # blocks[0] = pre-### lines in the zone (legacy bullet handoff)
    for raw in text.splitlines():
        m = HEADING_RE.match(raw)
        if m and len(m.group(1)) <= 2:
            in_zone = bool(TRAIL_HEADING_RE.match(raw))
            if in_zone:
                blocks = [[]]
            continue
        if not in_zone:
            continue
        if m:  # ### -> new block
            blocks.append([])
            continue
        blocks[-1].append(raw)
    chosen = []
    for b in blocks:
        if any(s.strip() for s in b):
            chosen = b
    return "## Trail\n" + "\n".join(chosen)


def has_blocker(doc):
    hay = doc["text"].lower()
    return "blocker" in hay or "blocked" in hay


def unflushed_commits(root, trail_text):
    """Commits on HEAD newer than the latest one this Trail anchors. Content-based
    staleness (not mtime). Returns (count, head_short, capped, tracked)."""
    WINDOW = 50
    try:
        out = subprocess.run(
            ["git", "rev-list", "-n", str(WINDOW), "HEAD"],
            cwd=root, capture_output=True, text=True,
        )
    except FileNotFoundError:
        return 0, None, False, True
    if out.returncode != 0:
        return 0, None, False, True
    hashes = out.stdout.split()
    if not hashes:
        return 0, None, False, True
    anchored = [m.strip() for k, m in ANCHOR_RE.findall(trail_text) if k == "commit"]
    if not anchored:
        return 0, hashes[0][:12], False, False
    count = 0
    for h in hashes:
        if any(h.startswith(a) or a.startswith(h[:7]) for a in anchored if a):
            return count, hashes[0][:12], False, True
        count += 1
    return count, hashes[0][:12], True, True


def ago(ts):
    d = max(0, time.time() - ts)
    if d < 3600:
        return "%dm ago" % (d // 60)
    if d < 86400:
        return "%dh ago" % (d // 3600)
    return "%dd ago" % (d // 86400)


# --- commands ---

def cmd_init(args):
    root = find_repo_root(os.getcwd())
    base = os.path.join(root, ".orca")
    made = []
    for d in (base, os.path.join(base, "done")):
        if not os.path.isdir(d):
            os.makedirs(d)
            made.append(os.path.relpath(d, root) + "/")
    if made:
        for m in made:
            print("  %s %s" % (_c(GREEN, "+"), m))
        print(_c(DIM, "add a focus: mkdir .orca/01-<name> && write .orca/01-<name>/focus.md"))
    else:
        print(_c(DIM, "already initialized (.orca/ in %s)" % root))
    return 0


def _ark_line(a, indent, root, is_done=False):
    """One ark: done-when, where you stopped (next/head from its latest Trail block),
    blocker flag, staleness warning."""
    sess = latest_session(a["text"])
    stopped = sess.get("next") or sess.get("done") or "(no Trail yet)"
    head = sess.get("head")
    tag = _c(DIM, " (done)") if is_done else (_c(RED, " ⚠ blocker") if has_blocker(a) else "")
    summary = a["fields"].get("intent") or a["fields"].get("done-when") or "—"
    print("%s· %s%s  %s"
          % (indent, a["slug"], tag, _c(DIM, summary)))
    print("%s    %s %s" % (indent, _c(DIM, "↳ stopped:"), _c(DIM, stopped)))
    if head:
        print("%s    %s %s" % (indent, _c(DIM, "↳ head:   "), _c(DIM, head)))
    if not is_done:
        n, head_hash, capped, tracked = unflushed_commits(root, a["text"])
        if tracked and n > 0:
            plural = "" if n == 1 else "s"
            print("%s    %s"
                  % (indent, _c(YELLOW, "⚠ %d%s commit%s after last anchored handoff (HEAD %s) — "
                                "handoff may be behind; reconcile before continuing"
                                % (n, "+" if capped else "", plural, head_hash))))


def cmd_now(args):
    """Resume view: every in-work focus + its Now + its open arks + where you
    stopped. Project-local only — reads this repo's .orca/, nothing global."""
    root = find_repo_root(os.getcwd())
    focuses = iter_focuses(root)

    print(_c(DIM, "orca now"))
    if not focuses:
        print(_c(DIM, "  nothing in-work. `orca init` then add .orca/<NN-name>/focus.md"))
        return 0

    for f in focuses:
        flag = _c(RED, " ⚠ blocker") if has_blocker(f) else ""
        print("\n%s focus %s%s  %s"
              % (_c(YELLOW, "▸"), f["slug"], flag, _c(DIM, ago(f["mtime"]))))
        print("    %s %s" % (_c(DIM, "intent:"), f["fields"].get("intent", "—")))
        now_lines = section_text(f["text"], "Now")
        for l in now_lines:
            print("    %s" % _c(DIM, l.rstrip()))
        n, head_hash, capped, tracked = unflushed_commits(root, f["text"])
        if tracked and n > 0:
            plural = "" if n == 1 else "s"
            print("    %s"
                  % _c(YELLOW, "⚠ %d%s commit%s after last anchored Trail block (HEAD %s) — "
                       "handoff may be behind; reconcile before continuing"
                       % (n, "+" if capped else "", plural, head_hash)))
        arks = focus_arks(f["dir"])
        if arks:
            print("    %s" % _c(DIM, "arks:"))
            for a in arks:
                _ark_line(a, "    ", root)
    return 0


def cmd_verify(args):
    root = find_repo_root(os.getcwd())
    path = args.arkfile or _default_handoff(root)
    if not path:
        print(_c(RED, "verify: no file given and no focus.md under .orca/"))
        return 2
    if not os.path.isfile(path):
        print(_c(RED, "verify: not a file: %s" % path))
        return 2

    with open(path, "r", errors="replace") as fh:
        text = fh.read()

    print(_c(DIM, "ark: %s  (root: %s)" % (os.path.relpath(path, root), root)))
    hand = latest_handoff_text(text)
    ok, lines, _ = check_anchors(hand, root, args.no_tests, args.timeout)
    if getattr(args, "judge", False):
        j_ok, j_lines = judge_pass(hand, root, args.timeout)
        lines = lines + j_lines
        ok = ok and j_ok
    for status, msg in lines:
        color, tag = _TAG[status]
        if status == "NONE":
            print(_c(YELLOW, msg))
        else:
            print("  %s %s" % (_c(color, tag), _c(DIM, msg)))
    print(_c(GREEN, "verify: PASS") if ok else _c(RED, "verify: FAIL"))
    return 0 if ok else 1


def _default_handoff(root):
    """The freshest in-work focus's focus.md — the live handoff to verify/gate."""
    focuses = iter_focuses(root)
    return focuses[0]["path"] if focuses else None


def cmd_gate(args):
    """Is the freshest in-work focus safe to end a session on? exit 0 = yes (or
    nothing in-work). exit 1 + reason = its latest Trail block is unproven.
    Non-blocking by nature: a hard exit bypasses hooks, so this just makes a broken
    handoff visible. Freshness is kept by flushing as you work, not by a gate."""
    root = find_repo_root(os.getcwd())
    focuses = iter_focuses(root)
    if not focuses:
        return 0
    f = focuses[0]
    ok, lines, n = check_anchors(latest_handoff_text(f["text"]), root,
                                 no_tests=True, timeout=args.timeout)
    if ok and n > 0:
        return 0
    why = "; ".join("%s %s" % (s, m) for s, m in lines if s in ("FAIL", "BARE", "NONE")) \
          or "no checkable anchors"
    print("handoff for focus '%s' is not verified: %s" % (f["slug"], why))
    return 1


def _decide_target(root, slug=None):
    """Where a decision lands. Returns (path, label, kind):
      kind="focus"   -> a specific focus's decisions.md
      kind="root"    -> project-level fallback (ambiguous: !=1 in-work focus)
      kind="missing" -> an explicit --focus slug matched nothing
    An explicit slug wins; else the sole in-work focus; else the project-level
    ledger so an ambiguous decision is never silently dropped (the caller WARNS)."""
    focuses = iter_focuses(root)
    if slug:
        for f in focuses:
            if f["slug"] == slug:
                return os.path.join(f["dir"], "decisions.md"), f["slug"], "focus"
        return None, slug, "missing"
    if len(focuses) == 1:
        return os.path.join(focuses[0]["dir"], "decisions.md"), focuses[0]["slug"], "focus"
    return os.path.join(root, ".orca", "decisions.md"), os.path.basename(root), "root"


def cmd_decide(args):
    """Append a decision + why to the focus's decisions.md (append-only, one writer).
    The middle continuity layer: next session reads WHY, not just what's done."""
    root = find_repo_root(os.getcwd())
    if not os.path.isdir(os.path.join(root, ".orca")):
        print(_c(RED, "decide: no .orca here — run `orca init` first"))
        return 2
    text = " ".join(args.text).strip()
    if not text:
        print(_c(RED, "decide: nothing to record"))
        return 2
    path, label, kind = _decide_target(root, getattr(args, "focus", None))
    if kind == "missing":
        slugs = [f["slug"] for f in iter_focuses(root)]
        print(_c(RED, "decide: no in-work focus '%s'" % label))
        if slugs:
            print("  in-work focuses: " + ", ".join(slugs))
        return 2
    if not os.path.exists(path):
        os.makedirs(os.path.dirname(path), exist_ok=True)
        with open(path, "w") as fh:
            fh.write("# decisions — %s\n\nWhy this work is the way it is. Append-only.\n"
                     % label)
    with open(path, "a") as fh:
        fh.write("- %s — %s\n" % (time.strftime("%Y-%m-%d", time.localtime()), text))
    print(_c(GREEN, "decided: ") + text)
    if kind == "root":
        slugs = [f["slug"] for f in iter_focuses(root)]
        print(_c(YELLOW, "  ↳ landed in project-level .orca/decisions.md "
                         "(%d in-work focuses — ambiguous)." % len(slugs)))
        print("    target one next time: orca decide --focus <%s> \"...\""
              % ("|".join(slugs) if slugs else "slug"))
    return 0


def cmd_trail(args):
    """One focus's (or ark's) whole arc, oldest->newest: the chain of thought you can
    re-read to remember how the work actually unfolded. Derived on read from the
    `## Trail` blocks — nothing stored, nothing rewritten."""
    root = find_repo_root(os.getcwd())
    # a focus dir name, or an ark slug
    focuses = {f["slug"]: f for f in iter_focuses(root, include_done=True)}
    if args.slug in focuses:
        doc = focuses[args.slug]
    else:
        ark, _focus, _done = find_ark(root, args.slug)
        if not ark:
            print(_c(RED, "trail: no such focus or ark: %s" % args.slug))
            return 2
        doc = ark
    text = doc["text"]
    fields = doc["fields"]
    blocks = all_sessions(text)

    print(_c(DIM, "trail: %s" % args.slug)
          + ("  " + _c(DIM, "done-when: " + fields["done-when"]) if fields.get("done-when") else ""))
    if not blocks:
        print(_c(DIM, "  no Trail blocks yet"))
        return 0
    for b in blocks:
        print("\n%s %s" % (_c(YELLOW, "──"), b.get("date", "?")))
        if b.get("done"):
            print("    %s %s" % (_c(GREEN, "done:"), b["done"]))
        if b.get("why"):
            print("    %s %s" % (_c(DIM, "why: "), _c(DIM, b["why"])))
        if b.get("next"):
            print("    %s %s" % (_c(DIM, "next:"), _c(DIM, b["next"])))
        if b.get("head"):
            print("    %s %s" % (_c(DIM, "head:"), _c(DIM, b["head"])))
    return 0


def _append_log(focus, slug, state):
    """Append one ark state-transition line to a focus's `## Log` (append-only).
    Creates the section if absent."""
    path = focus["path"]
    line = "%s  %s  → %s\n" % (time.strftime("%Y-%m-%d", time.localtime()), slug, state)
    with open(path, "r", errors="replace") as fh:
        text = fh.read()
    if re.search(r"^#{1,6}\s+Log\b", text, re.IGNORECASE | re.MULTILINE):
        if not text.endswith("\n"):
            text += "\n"
        text += line
    else:
        if not text.endswith("\n"):
            text += "\n"
        text += "\n## Log\n<!-- ark state transitions, append-only -->\n" + line
    with open(path, "w") as fh:
        fh.write(text)


def cmd_done(args):
    """Finish work by MOVING it — location is the one terminal 'done' truth, no
    `state:` flip. An ark moves to arks/done/ and gets a line in its focus's
    `## Log`. A focus moves whole to .orca/done/. File content moves byte-for-byte;
    closing is never rewriting history. Idempotent."""
    root = find_repo_root(os.getcwd())
    base = os.path.join(root, ".orca")

    # ark first (more common), then focus dir
    ark, focus, already_done = find_ark(root, args.slug)
    if ark and not already_done:
        adir = os.path.dirname(ark["path"])
        dest_dir = os.path.join(adir, "done")
        os.makedirs(dest_dir, exist_ok=True)
        dest = os.path.join(dest_dir, args.slug + ".md")
        os.rename(ark["path"], dest)
        _append_log(focus, args.slug, "done")
        print(_c(GREEN, "done: ") + args.slug
              + _c(DIM, "  -> %s" % os.path.relpath(dest, root)))
        return 0
    if ark and already_done:
        print(_c(DIM, "done: ark '%s' already done" % args.slug))
        return 0

    # focus dir?
    live = os.path.join(base, args.slug)
    archived = os.path.join(base, "done", args.slug)
    if os.path.isdir(archived) and not os.path.isdir(live):
        print(_c(DIM, "done: focus '%s' already done" % args.slug))
        return 0
    if os.path.isdir(live) and os.path.isfile(os.path.join(live, "focus.md")):
        os.makedirs(os.path.join(base, "done"), exist_ok=True)
        os.rename(live, archived)
        print(_c(GREEN, "done: ") + args.slug
              + _c(DIM, "  -> .orca/done/%s/" % args.slug))
        return 0

    print(_c(RED, "done: no such ark or focus: %s" % args.slug))
    return 2


# --- session-context ledger: the MUST layer that makes resume live-aware ---
#
# One fact recorded at SessionStart closes three holes at once (decision #19):
#   (1) live-detection  — a transcript still being written must NOT be compressed
#       (parallel different-ark sessions → silent partial/double folding = corruption);
#   (2) set-compression — resume folds EVERY uncompressed prior session, not just one
#       (the `compressed` flag makes "already folded" deterministic, not an mtime guess);
#   (3) attribution + dir — the EXACT transcript path is recorded, so resume never has
#       to mangle the launch dir to find it, and cwd attributes the session to a project.
# Records live in <project>/.orca/sessions/<id>.json — project-local, ephemeral
# (gitignored). Written at SessionStart (a fact, not background — #19); never at Stop
# (Stop fires every turn, so it can't mean "ended"). Liveness is read from the
# transcript's mtime, which Claude Code advances every turn — the heartbeat for free.

LIVE_WINDOW = int(os.environ.get("ORCA_LIVE_WINDOW", "45"))  # seconds; transcript idle
                                                             # longer than this = safe


def sessions_dir(root):
    return os.path.join(root, ".orca", "sessions")


def _read_json(path):
    try:
        with open(path) as fh:
            return json.load(fh)
    except (OSError, ValueError):
        return None


def _session_record(args):
    """Write/merge this session's record from the Claude Code hook JSON on stdin.
    Never breaks the hook: missing fields or bad JSON just exits 0 silently."""
    raw = ""
    try:
        if not sys.stdin.isatty():
            raw = sys.stdin.read()
    except (OSError, ValueError):
        raw = ""
    try:
        data = json.loads(raw) if raw.strip() else {}
    except ValueError:
        data = {}
    sid = data.get("session_id") or data.get("session") or os.environ.get("CLAUDE_SESSION_ID")
    transcript = data.get("transcript_path") or data.get("transcript")
    cwd = data.get("cwd") or os.getcwd()
    if not sid:
        return 0  # nothing to record — do not break the hook
    root = find_repo_root(cwd)
    if not os.path.isdir(os.path.join(root, ".orca")):
        return 0  # not an orca project — nothing to do
    sdir = sessions_dir(root)
    os.makedirs(sdir, exist_ok=True)
    path = os.path.join(sdir, sid + ".json")
    rec = _read_json(path) or {}
    rec.update({
        "session": sid,
        "transcript": transcript or rec.get("transcript"),
        "cwd": os.path.realpath(cwd),
        "started": rec.get("started") or int(time.time()),
    })
    rec.setdefault("compressed", False)
    with open(path, "w") as fh:
        json.dump(rec, fh)
    return 0


def _session_pending(args):
    """Print prior sessions safe to compress, oldest first. Excludes: the CURRENT
    session (freshest transcript mtime — being written now), LIVE ones (transcript
    touched within LIVE_WINDOW), already-compressed, and other projects (cwd).
    Output is TSV the resume skill consumes:
        pending\t<id>\t<transcript-path>\t<cwd>
        live\t<id>\t<transcript-path>\t<reason>
    (live rows are warnings — resume skips them loudly rather than risk corruption.)"""
    root = find_repo_root(os.getcwd())
    sdir = sessions_dir(root)
    if not os.path.isdir(sdir):
        return 0
    existing = []
    for f in glob.glob(os.path.join(sdir, "*.json")):
        r = _read_json(f)
        t = r.get("transcript") if r else None
        if r and t and os.path.isfile(t):
            existing.append((r, os.path.getmtime(t)))
    if not existing:
        return 0
    existing.sort(key=lambda x: x[1])         # oldest first
    current_id = existing[-1][0]["session"]    # freshest = this session, being written
    now = time.time()
    root_real = os.path.realpath(root)
    pend, live = [], []
    for r, mt in existing:
        if r["session"] == current_id or r.get("compressed"):
            continue
        if os.path.realpath(find_repo_root(r.get("cwd") or root)) != root_real:
            continue  # belongs to another project
        if now - mt < LIVE_WINDOW:
            live.append((r, mt))
        else:
            pend.append((r, mt))
    for r, mt in pend:
        print("pending\t%s\t%s\t%s" % (r["session"], r["transcript"], r.get("cwd", "")))
    for r, mt in live:
        print("live\t%s\t%s\ttranscript touched %ds ago (< %ds) — possibly in-progress; skipped"
              % (r["session"], r["transcript"], int(now - mt), LIVE_WINDOW))
    return 0


def _session_mark(args):
    """Mark a session's transcript as folded into a Trail block (so it is never
    double-compressed). Idempotent."""
    root = find_repo_root(os.getcwd())
    path = os.path.join(sessions_dir(root), args.id + ".json")
    rec = _read_json(path)
    if not rec:
        sys.stderr.write("session: no record for %s\n" % args.id)
        return 2
    rec["compressed"] = True
    with open(path, "w") as fh:
        json.dump(rec, fh)
    print(_c(GREEN, "marked compressed: ") + args.id)
    return 0


def _session_prune(args):
    """Drop already-folded session records older than --days. The ledger is
    ephemeral (gitignored) but never self-collects, so compressed records would
    otherwise pile up one-per-session forever. Only `compressed` records are
    eligible — an uncompressed record may still be owed a Trail block, so it is
    never swept by age. Explicit + opt-in (no auto-sweep in the hot hook path)."""
    root = find_repo_root(os.getcwd())
    sdir = sessions_dir(root)
    if not os.path.isdir(sdir):
        return 0
    cutoff = time.time() - args.days * 86400
    removed = 0
    for f in glob.glob(os.path.join(sdir, "*.json")):
        r = _read_json(f)
        if not r or not r.get("compressed"):
            continue                      # never sweep an unfolded record
        if (r.get("started") or 0) >= cutoff:
            continue                      # too young
        try:
            os.remove(f)
            removed += 1
        except OSError:
            pass
    print(_c(GREEN, "pruned: ") + "%d compressed record(s) older than %dd" % (removed, args.days))
    return 0


def cmd_session(args):
    action = getattr(args, "action", None)
    if action == "record":
        return _session_record(args)
    if action == "pending":
        return _session_pending(args)
    if action == "compressed":
        return _session_mark(args)
    if action == "prune":
        return _session_prune(args)
    sys.stderr.write("session: use record | pending | compressed <id> | prune\n")
    return 2


def main(argv=None):
    p = argparse.ArgumentParser(prog="orca", description=__doc__,
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest="cmd")

    sub.add_parser("init", help="scaffold project .orca/").set_defaults(func=cmd_init)

    sub.add_parser("now", help="resume view: in-work focuses + open arks + where you stopped"
                   ).set_defaults(func=cmd_now)

    v = sub.add_parser("verify", help="verify a handoff's Trail anchors against reality")
    v.add_argument("arkfile", nargs="?", help="file (default: freshest in-work focus.md)")
    v.add_argument("--no-tests", action="store_true", help="skip re-running [test:] anchors")
    v.add_argument("--timeout", type=int, default=120, help="per-test timeout seconds")
    v.add_argument("--judge", action="store_true",
                   help="also ask a separate cheap model if each done: claim is grounded "
                        "in its evidence (pluggable via ORCA_JUDGE_CMD; off by default)")
    v.set_defaults(func=cmd_verify)

    d = sub.add_parser("decide", help="append a decision + why to the focus's decisions.md")
    d.add_argument("text", nargs="+", help="the decision and its reason, e.g. \"per-axis collision — wall-slide for free\"")
    d.add_argument("--focus", help="target this in-work focus by slug (else: the sole in-work focus, or project-level on ambiguity)")
    d.set_defaults(func=cmd_decide)

    tr = sub.add_parser("trail", help="render one focus's (or ark's) Trail oldest->newest")
    tr.add_argument("slug", help="focus dir name or ark slug")
    tr.set_defaults(func=cmd_trail)

    dn = sub.add_parser("done", help="finish an ark (-> arks/done/ + Log line) or a focus (-> .orca/done/)")
    dn.add_argument("slug", help="ark slug or focus dir name")
    dn.set_defaults(func=cmd_done)

    g = sub.add_parser("gate", help="exit 1 + reason if the freshest focus's latest Trail block isn't verified")
    g.add_argument("--timeout", type=int, default=120, help="per-test timeout seconds")
    g.set_defaults(func=cmd_gate)

    se = sub.add_parser("session", help="session-context ledger (makes resume live-aware): record | pending | compressed | prune")
    se_sub = se.add_subparsers(dest="action")
    se_sub.add_parser("record", help="record this session from the Claude Code hook JSON on stdin (SessionStart)")
    se_sub.add_parser("pending", help="list prior sessions safe to compress (excludes current + live + already-folded + other projects)")
    se_c = se_sub.add_parser("compressed", help="mark a session's transcript as folded into a Trail block")
    se_c.add_argument("id", help="session id")
    se_p = se_sub.add_parser("prune", help="drop already-folded session records older than --days (default 30)")
    se_p.add_argument("--days", type=int, default=30, help="age threshold in days (default 30)")
    se.set_defaults(func=cmd_session)

    args = p.parse_args(argv)
    if not getattr(args, "func", None):
        p.print_help()
        return 0
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main())
