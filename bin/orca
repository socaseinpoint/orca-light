#!/usr/bin/env python3
"""orca — lightweight session continuity for Claude Code.

Files are state. Views are derived on read. One writer per file. No locks,
no lifecycle flips, no scheduler, no shared mutable state.

The trust foundation is `orca verify`: a handoff is not faith-based prose, it
is claims + checkable anchors. If an anchor is fake, verify fails. Confabulated
continuity gets caught here instead of silently poisoning the next session.

Anchors (inline in handoff bullets):
  [file:PATH:LINE]   -> PATH exists and has >= LINE lines
  [commit:HASH]      -> HASH resolves to a commit in this repo
  [test:COMMAND]     -> COMMAND re-runs with exit 0 (skipped with --no-tests)

Usage:
  orca init                            scaffold meta-tier ~/.orca + project .orca
  orca verify [ARKFILE] [--no-tests]   check a handoff's anchors against reality
  orca now                             resume: goal + open arks + where you stopped + blockers
  orca gate                            warn (exit 1) if the freshest active ark's handoff isn't verified
  orca decide "<what> — <why>"         append a decision to .orca/decisions.md (the WHY layer)

Topology (all views derived on read, nothing derived is stored):
  ~/.orca/threads/<thread>.md   cross-project intent + goal (one writer)
  <project>/.orca/arks/<slug>.md   a thread of work: intent, done-when, handoff
Override the meta home with ORCA_HOME (used by tests).
"""
import argparse
import glob
import os
import re
import subprocess
import sys
import time

ANCHOR_RE = re.compile(r"\[(file|commit|test):([^\]]+)\]")
HANDOFF_HEADING_RE = re.compile(r"^#{1,6}\s+handoff\b", re.IGNORECASE)
SESSIONS_HEADING_RE = re.compile(r"^#{1,6}\s+sessions\b", re.IGNORECASE)
HEADING_RE = re.compile(r"^(#{1,6})\s")
BULLET_RE = re.compile(r"^\s*[-*]\s+\S")
DONE_RE = re.compile(r"^\s*done:\s*\S", re.IGNORECASE)  # proven-zone field (schema v2)

GREEN, RED, YELLOW, DIM, RESET = "\033[32m", "\033[31m", "\033[33m", "\033[2m", "\033[0m"


def _c(color, text):
    return text if not sys.stdout.isatty() else color + text + RESET


def find_repo_root(start):
    """Nearest ancestor holding .orca/, else git toplevel, else start."""
    cur = os.path.abspath(start)
    while True:
        if os.path.isdir(os.path.join(cur, ".orca")):
            return cur
        parent = os.path.dirname(cur)
        if parent == cur:
            break
        cur = parent
    try:
        out = subprocess.run(
            ["git", "rev-parse", "--show-toplevel"],
            cwd=start, capture_output=True, text=True, check=True,
        )
        return out.stdout.strip()
    except (subprocess.CalledProcessError, FileNotFoundError):
        return os.path.abspath(start)


def default_arkfile(root):
    arks = os.path.join(root, ".orca", "arks")
    if not os.path.isdir(arks):
        return None
    cands = [
        os.path.join(arks, f)
        for f in os.listdir(arks)
        if f.endswith(".md")
    ]
    if not cands:
        return None
    # freshest by mtime; views are derived, so no stored "active" flag
    cands.sort(key=os.path.getmtime, reverse=True)
    return cands[0]


def check_file(payload, root):
    if ":" not in payload:
        return False, "no :LINE in anchor"
    path, _, line_s = payload.rpartition(":")
    try:
        line = int(line_s)
    except ValueError:
        return False, "line not an int: %r" % line_s
    abs_path = path if os.path.isabs(path) else os.path.join(root, path)
    if not os.path.isfile(abs_path):
        return False, "file not found: %s" % path
    with open(abs_path, "r", errors="replace") as fh:
        n = sum(1 for _ in fh)
    if line < 1 or line > n:
        return False, "line %d out of range (file has %d)" % (line, n)
    return True, "%s:%d ok" % (path, line)


def check_commit(payload, root):
    h = payload.strip()
    try:
        out = subprocess.run(
            ["git", "rev-parse", "--verify", "--quiet", h + "^{commit}"],
            cwd=root, capture_output=True, text=True,
        )
    except FileNotFoundError:
        return False, "git not available"
    if out.returncode != 0 or not out.stdout.strip():
        return False, "no such commit: %s" % h
    return True, "commit %s" % out.stdout.strip()[:12]


def check_test(payload, root, timeout):
    cmd = payload.strip()
    try:
        out = subprocess.run(
            cmd, cwd=root, shell=True, capture_output=True, text=True,
            timeout=timeout,
        )
    except subprocess.TimeoutExpired:
        return False, "timed out after %ss" % timeout
    if out.returncode != 0:
        tail = (out.stderr or out.stdout or "").strip().splitlines()
        tail = tail[-1] if tail else ""
        return False, "exit %d: %s" % (out.returncode, tail[:80])
    return True, "exit 0"


# --- claim<->evidence judging: pluggable, OFF by default; deterministic core stays ---

DONE_CLAIM_RE = re.compile(r"^\s*done:\s*(.+)$", re.IGNORECASE)


def _truncate(s, n):
    s = s or ""
    return s if len(s) <= n else s[:n] + "\n…[truncated]"


def evidence_for(kind, payload, root, timeout):
    """A receipt: the real artifact behind an anchor, rendered as text a judge reads.
    This is orca's strong, deterministic half — the evidence is reality, not prose."""
    if kind == "commit":
        out = subprocess.run(["git", "show", "--stat", "-p", payload.strip()],
                             cwd=root, capture_output=True, text=True)
        return _truncate(out.stdout, 3000) if out.returncode == 0 else "(commit not found)"
    if kind == "file":
        path, _, line_s = payload.rpartition(":")
        try:
            line = int(line_s)
        except ValueError:
            return "(bad file anchor)"
        abs_path = path if os.path.isabs(path) else os.path.join(root, path)
        if not os.path.isfile(abs_path):
            return "(file not found)"
        with open(abs_path, "r", errors="replace") as fh:
            rows = fh.readlines()
        lo, hi = max(0, line - 4), min(len(rows), line + 3)
        return "%s lines %d-%d:\n%s" % (path, lo + 1, hi, _truncate("".join(rows[lo:hi]), 1500))
    if kind == "test":
        try:
            out = subprocess.run(payload.strip(), cwd=root, shell=True,
                                 capture_output=True, text=True, timeout=timeout)
        except subprocess.TimeoutExpired:
            return "(test timed out)"
        body = (out.stdout or "") + (out.stderr or "")
        return "exit %d\n%s" % (out.returncode, _truncate(body, 1500))
    return ""


def iter_done_claims(text):
    """Each provable claim + its anchors: v2 `done:` lines and v1 `## handoff` bullets.
    The orient zone (why/next/head) is intent — never judged."""
    claims, zone = [], None
    for raw in text.splitlines():
        m = HEADING_RE.match(raw)
        if m and len(m.group(1)) <= 2:
            zone = ("handoff" if HANDOFF_HEADING_RE.match(raw)
                    else "sessions" if SESSIONS_HEADING_RE.match(raw) else None)
            continue
        if m:
            continue
        anchors = ANCHOR_RE.findall(raw)
        if not anchors:
            continue
        if zone == "sessions":
            dm = DONE_CLAIM_RE.match(raw)
            if dm:
                claims.append((dm.group(1).strip(), anchors))
        elif zone == "handoff" and BULLET_RE.match(raw):
            claims.append((raw.strip().lstrip("-* ").strip(), anchors))
    return claims


def judge_claim(claim, evidence, timeout):
    """Ask a SEPARATE cheap model whether the evidence substantiates the claim.
    The handoff's writer must not grade itself — fresh model, skeptical by default.
    Pluggable via ORCA_JUDGE_CMD (default: Claude Haiku). Unavailable judge =
    skipped (grounded), so the deterministic core never depends on it."""
    cmd = os.environ.get("ORCA_JUDGE_CMD", "claude -p --model claude-haiku-4-5")
    prompt = (
        "You are a STRICT grader. Decide if the EVIDENCE substantiates the CLAIM.\n"
        "The evidence is real (git/files/tests). Be skeptical: if it does not clearly\n"
        "show the claimed work, answer NO. A passing test or an existing commit that is\n"
        "UNRELATED to the claim is NOT support.\n"
        "First word must be YES or NO, then one short reason.\n\n"
        "CLAIM: %s\n\nEVIDENCE:\n%s\n" % (claim, evidence)
    )
    try:
        out = subprocess.run(cmd, shell=True, input=prompt,
                             capture_output=True, text=True, timeout=timeout)
    except (subprocess.TimeoutExpired, FileNotFoundError):
        return True, "judge unavailable (skipped)"
    resp = (out.stdout or "").strip()
    if out.returncode != 0 or not resp:
        return True, "judge unavailable (skipped)"
    words = resp.split()
    grounded = not words[0].upper().strip(".:,").startswith("NO")
    reason = " ".join(words[1:])[:100] if len(words) > 1 else resp[:100]
    return grounded, reason


def judge_pass(text, root, timeout):
    """Returns (ok, lines) — UNGROUND for each done: claim the judge can't substantiate."""
    lines, ok = [], True
    for claim, anchors in iter_done_claims(text):
        evidence = "\n---\n".join(evidence_for(k, p, root, timeout) for k, p in anchors)
        grounded, reason = judge_claim(claim, evidence, timeout)
        lines.append((("GROUND" if grounded else "UNGROUND"),
                      "%s — %s" % (claim[:60], reason)))
        ok = ok and grounded
    return ok, lines


def proven_lines(text):
    """Lines in the proven zone — `done:` (v2) and `## handoff` bullets (v1). Anchors
    are checked ONLY here. Prose in why/next/head/decisions may quote `[test:...]`
    freely without verify trying to run it (a battle test surfaced this)."""
    out, zone = [], None
    for raw in text.splitlines():
        m = HEADING_RE.match(raw)
        if m and len(m.group(1)) <= 2:
            zone = ("handoff" if HANDOFF_HEADING_RE.match(raw)
                    else "sessions" if SESSIONS_HEADING_RE.match(raw) else None)
            continue
        if m:
            continue
        if zone == "sessions" and DONE_RE.match(raw):
            out.append(raw)
        elif zone == "handoff" and BULLET_RE.match(raw):
            out.append(raw)
    return "\n".join(out)


def bare_claims(text):
    """Unproven claims in the *proven* zone. Two schemas, one rule — a claim that
    asserts work is done must carry an anchor:
      v1  `## handoff`  -> every bullet needs an anchor
      v2  `## sessions` -> every `done:` line needs an anchor; `why:/next:/head:`
                           are the orient zone (narrative) and are never flagged.
    A `###` date subheading inside `## sessions` does not close the zone; only a
    new top-level (`#`/`##`) heading does."""
    flagged = []
    zone = None  # "handoff" | "sessions" | None
    for raw in text.splitlines():
        m = HEADING_RE.match(raw)
        if m and len(m.group(1)) <= 2:  # top-level section heading -> may switch zone
            if HANDOFF_HEADING_RE.match(raw):
                zone = "handoff"
            elif SESSIONS_HEADING_RE.match(raw):
                zone = "sessions"
            else:
                zone = None
            continue
        if m:  # deeper heading (### session date) -> keep current zone
            continue
        if ANCHOR_RE.search(raw):
            continue
        if zone == "handoff" and BULLET_RE.match(raw):
            flagged.append(raw.strip())
        elif zone == "sessions" and DONE_RE.match(raw):
            flagged.append(raw.strip())
    return flagged


def check_anchors(text, root, no_tests, timeout):
    """Core check. Returns (ok, lines, n_anchors). Pure — no printing.
    lines are (status, message) tuples where status in OK/FAIL/SKIP/BARE/NONE."""
    anchors = ANCHOR_RE.findall(proven_lines(text))
    lines, ok = [], True
    if not anchors:
        lines.append(("NONE", "no anchors found — handoff is unproven prose"))
    for kind, payload in anchors:
        if kind == "file":
            passed, msg = check_file(payload, root)
        elif kind == "commit":
            passed, msg = check_commit(payload, root)
        else:  # test
            if no_tests:
                lines.append(("SKIP", "[test:%s] (--no-tests)" % payload))
                continue
            passed, msg = check_test(payload, root, timeout)
        lines.append(("OK" if passed else "FAIL", "[%s:%s] %s" % (kind, payload, msg)))
        ok = ok and passed
    for b in bare_claims(text):
        lines.append(("BARE", b[:90]))
        ok = False
    return ok, lines, len(anchors)


_TAG = {"OK": (GREEN, " OK "), "FAIL": (RED, "FAIL"), "SKIP": (YELLOW, "SKIP"),
        "BARE": (YELLOW, "BARE"), "NONE": (YELLOW, "----"),
        "GROUND": (GREEN, "GRND"), "UNGROUND": (RED, "UNGR")}


def cmd_verify(args):
    root = find_repo_root(os.getcwd())
    path = args.arkfile or default_arkfile(root)
    if not path:
        print(_c(RED, "verify: no ark file given and none under .orca/arks/"))
        return 2
    if not os.path.isfile(path):
        print(_c(RED, "verify: not a file: %s" % path))
        return 2

    with open(path, "r", errors="replace") as fh:
        text = fh.read()

    print(_c(DIM, "ark: %s  (root: %s)" % (os.path.relpath(path, root), root)))
    ok, lines, _ = check_anchors(text, root, args.no_tests, args.timeout)
    if getattr(args, "judge", False):
        j_ok, j_lines = judge_pass(text, root, args.timeout)
        lines = lines + j_lines
        ok = ok and j_ok
    for status, msg in lines:
        color, tag = _TAG[status]
        if status == "NONE":
            print(_c(YELLOW, msg))
        else:
            print("  %s %s" % (_c(color, tag), _c(DIM, msg)))
    print(_c(GREEN, "verify: PASS") if ok else _c(RED, "verify: FAIL"))
    return 0 if ok else 1


def cmd_gate(args):
    """Is the freshest active ark safe to end a session on? exit 0 = yes (or
    nothing active). exit 1 + reason = its handoff is unproven. Non-blocking by
    nature — Stop fires every turn and a hard exit (Ctrl-C) bypasses hooks, so a
    blocking gate would nag yet still miss kills. This just makes a broken or
    fabricated handoff *visible*; freshness is kept by flushing as you work, not
    by a gate. Run it by hand any time, or let the Stop hook warn with it."""
    root = find_repo_root(os.getcwd())
    open_arks = [a for a in iter_arks(root) if is_open(a)]
    if not open_arks:
        return 0  # nothing active — nothing to hand off
    ark = open_arks[0]  # freshest active
    ok, lines, n = check_anchors(ark["text"], root, no_tests=True, timeout=args.timeout)
    if ok and n > 0:
        return 0
    why = "; ".join("%s %s" % (s, m) for s, m in lines if s in ("FAIL", "BARE", "NONE")) \
          or "no checkable anchors"
    print("handoff for '%s' is not verified: %s" % (ark["slug"], why))
    return 1


# --- topology: meta-tier ~/.orca + project .orca, all derivation on read ---

FIELD_RE = re.compile(r"([A-Za-z][\w-]*):\s*(.*)$")


def meta_home():
    """Cross-project meta-tier. ORCA_HOME override keeps tests off real ~/.orca."""
    return os.environ.get("ORCA_HOME") or os.path.join(os.path.expanduser("~"), ".orca")


def parse_fields(text):
    """Leading `key: value` block (after the title heading, before first section)."""
    fields = {}
    for raw in text.splitlines():
        s = raw.strip()
        if s.startswith("#"):
            continue
        if not s:
            if fields:
                break
            continue
        m = FIELD_RE.match(s)
        if m:
            fields[m.group(1).lower()] = m.group(2).strip()
        elif fields:
            break
    return fields


def section_bullets(text, name):
    """Bullets under `## <name>`."""
    out, in_sec = [], False
    head = re.compile(r"^#{1,6}\s+" + re.escape(name) + r"\b", re.IGNORECASE)
    for raw in text.splitlines():
        if raw.startswith("#"):
            in_sec = bool(head.match(raw))
            continue
        if in_sec and BULLET_RE.match(raw):
            out.append(raw.strip().lstrip("-* ").strip())
    return out


def _load_docs(directory):
    docs = []
    for f in sorted(glob.glob(os.path.join(directory, "*.md"))):
        with open(f, "r", errors="replace") as fh:
            text = fh.read()
        docs.append({
            "slug": os.path.splitext(os.path.basename(f))[0],
            "path": f, "text": text, "fields": parse_fields(text),
            "mtime": os.path.getmtime(f),
        })
    docs.sort(key=lambda d: d["mtime"], reverse=True)  # freshest first
    return docs


def iter_arks(project_root):
    return _load_docs(os.path.join(project_root, ".orca", "arks"))


def iter_threads(home):
    return _load_docs(os.path.join(home, "threads"))


def is_open(ark):
    return ark["fields"].get("state", "active").lower() != "archived"


def has_blocker(ark):
    hay = ark["text"].lower()
    return "blocker" in hay or "blocked" in hay


def unflushed_commits(root, ark_text):
    """Commits on HEAD newer than the latest one this handoff anchors.

    Content-based staleness (not mtime — mtime lies after a checkout or a stray
    editor touch). If work was committed *after* the handoff last referenced a
    commit, the handoff is behind: a hard exit (Ctrl-C / crash) bypasses the Stop
    hook, so the flush that would have caught up never ran. We cannot recover an
    unwritten flush, but we can refuse to let the next session believe a stale
    handoff is current — same contract as `verify`: make the gap visible.

    Returns (count, head_short, capped, tracked).
      tracked=False -> the ark has no [commit:] anchor at all, so freshness can't
        be tracked (count is 0; not an alarm, just unprovable — a test/file-only
        ark is legitimate, it just can't be compared against the commit graph).
      tracked=True, count>0 -> genuinely behind: commits landed after the newest
        commit the handoff anchors.
    Walks at most WINDOW commits back; `capped` is True if we hit the wall
    without matching an anchored commit."""
    WINDOW = 50
    try:
        out = subprocess.run(
            ["git", "rev-list", "-n", str(WINDOW), "HEAD"],
            cwd=root, capture_output=True, text=True,
        )
    except FileNotFoundError:
        return 0, None, False, True
    if out.returncode != 0:
        return 0, None, False, True
    hashes = out.stdout.split()
    if not hashes:
        return 0, None, False, True
    anchored = [m.strip() for k, m in ANCHOR_RE.findall(ark_text) if k == "commit"]
    if not anchored:
        return 0, hashes[0][:12], False, False  # untracked, not behind
    count = 0
    for h in hashes:
        if any(h.startswith(a) or a.startswith(h[:7]) for a in anchored if a):
            return count, hashes[0][:12], False, True
        count += 1
    return count, hashes[0][:12], True, True  # anchored, but no match in window


def ago(ts):
    d = max(0, time.time() - ts)
    if d < 3600:
        return "%dm ago" % (d // 60)
    if d < 86400:
        return "%dh ago" % (d // 3600)
    return "%dd ago" % (d // 86400)


def cmd_init(args):
    home = meta_home()
    made = []
    seeds = [
        (os.path.join(home, "threads"), None),
        (os.path.join(home, "decisions.md"),
         "# decisions — cross-project (meta)\n\nAppend-only. Why, not what.\n"),
        (os.path.join(home, "trail-archive.md"),
         "# trail-archive — retired handoffs\n"),
    ]
    if not os.path.isdir(home):
        os.makedirs(home)
        made.append(home + "/")
    for path, content in seeds:
        if content is None:
            if not os.path.isdir(path):
                os.makedirs(path)
                made.append(path + "/")
        elif not os.path.exists(path):
            with open(path, "w") as fh:
                fh.write(content)
            made.append(path)
    if not os.path.isdir(os.path.join(home, ".git")):
        subprocess.run(["git", "init", "-q"], cwd=home)
        made.append(home + "/.git")

    root = find_repo_root(os.getcwd())
    pdir = os.path.join(root, ".orca")
    if not os.path.isdir(os.path.join(pdir, "arks")):
        os.makedirs(os.path.join(pdir, "arks"))
        made.append(os.path.join(pdir, "arks") + "/")
    pdec = os.path.join(pdir, "decisions.md")
    if not os.path.exists(pdec):
        with open(pdec, "w") as fh:
            fh.write("# decisions — %s\n\nWhy this repo's code is the way it is.\n"
                     % os.path.basename(root))
        made.append(pdec)

    # register this project root so `orca report` can roll up across all projects.
    # Append-only, one writer, deduped on read — no mutable index to desync.
    reg = os.path.join(home, "projects")
    existing = set()
    if os.path.isfile(reg):
        with open(reg) as fh:
            existing = set(l.strip() for l in fh)
    if root not in existing:
        with open(reg, "a") as fh:
            fh.write(root + "\n")
        made.append(reg + " (registered %s)" % os.path.basename(root))

    if made:
        for m in made:
            print("  %s %s" % (_c(GREEN, "+"), m))
    else:
        print(_c(DIM, "already initialized (meta: %s)" % home))
    return 0


def latest_session(text):
    """Fields of the freshest `### ` block under `## sessions` (schema v2), else {}.
    Newest block is first; we read only it. Returns dict of done/why/next/head."""
    in_sessions, started, block = False, False, {}
    for raw in text.splitlines():
        m = HEADING_RE.match(raw)
        if m and len(m.group(1)) <= 2:
            in_sessions = bool(SESSIONS_HEADING_RE.match(raw))
            continue
        if not in_sessions:
            continue
        if m:  # ### date subheading
            if started:
                break  # only the freshest block
            started = True
            continue
        if started:
            fm = re.match(r"^\s*(done|why|next|head):\s*(.+)$", raw, re.IGNORECASE)
            if fm:
                block[fm.group(1).lower()] = fm.group(2).strip()
    return block


def _ark_line(a, indent, root):
    """One ark: done-when, where you stopped, mental thread, blocker flag, and a
    staleness warning if commits landed after the last anchored handoff. Prefers
    schema v2 session blocks (next/head); falls back to v1 handoff bullets."""
    sess = latest_session(a["text"])
    if sess:
        stopped = sess.get("next") or sess.get("done") or "(session has no next)"
        head = sess.get("head")
    else:
        hand = section_bullets(a["text"], "handoff")
        stopped = hand[-1] if hand else "(no handoff yet)"
        head = None
    flag = _c(RED, " ⚠ blocker") if has_blocker(a) else ""
    print("%s· %s%s  %s"
          % (indent, a["slug"], flag,
             _c(DIM, "done-when: " + a["fields"].get("done-when", "—"))))
    print("%s    %s %s"
          % (indent, _c(DIM, "↳ stopped:"), _c(DIM, stopped)))
    if head:
        print("%s    %s %s" % (indent, _c(DIM, "↳ head:   "), _c(DIM, head)))
    n, head_hash, capped, tracked = unflushed_commits(root, a["text"])
    if not tracked and not sess:
        # v1 arks with no commit anchor: can't track freshness, say so quietly
        print("%s    %s" % (indent, _c(DIM, "↳ (no [commit:] anchor — freshness untracked)")))
    elif tracked and n > 0:
        plural = "" if n == 1 else "s"
        print("%s    %s"
              % (indent, _c(YELLOW, "⚠ %d%s commit%s after last anchored handoff (HEAD %s) — "
                            "handoff may be behind; reconcile before continuing"
                            % (n, "+" if capped else "", plural, head_hash))))


def cmd_decide(args):
    """Append a decision + why to .orca/decisions.md (append-only, one writer).
    The middle continuity layer: next session reads WHY, not just what's done.
    Meant to be run by the agent the moment a non-obvious call is made."""
    root = find_repo_root(os.getcwd())
    ddir = os.path.join(root, ".orca")
    if not os.path.isdir(ddir):
        print(_c(RED, "decide: no .orca here — run `orca init` first"))
        return 2
    text = " ".join(args.text).strip()
    if not text:
        print(_c(RED, "decide: nothing to record"))
        return 2
    path = os.path.join(ddir, "decisions.md")
    if not os.path.exists(path):
        with open(path, "w") as fh:
            fh.write("# decisions — %s\n\nWhy this repo is the way it is. Append-only.\n"
                     % os.path.basename(root))
    with open(path, "a") as fh:
        fh.write("- %s — %s\n" % (time.strftime("%Y-%m-%d", time.localtime()), text))
    print(_c(GREEN, "decided: ") + text)
    return 0


def cmd_now(args):
    """Resume view: goal + open arks + where you stopped + blockers. One view."""
    home = meta_home()
    root = find_repo_root(os.getcwd())
    threads = iter_threads(home)
    open_arks = [a for a in iter_arks(root) if is_open(a)]

    print(_c(DIM, "orca now  ·  %s" % os.path.basename(root)))
    if not threads and not open_arks:
        print(_c(DIM, "  nothing open. `orca init` then add .orca/arks/<slug>.md"))
        return 0

    claimed = set()
    for t in threads:
        print("\n%s %s  %s" % (_c(YELLOW, "▸"), t["slug"], _c(DIM, ago(t["mtime"]))))
        print("    goal: %s" % t["fields"].get("goal", "—"))
        for a in [x for x in open_arks if x["fields"].get("thread", "") == t["slug"]]:
            claimed.add(a["slug"])
            _ark_line(a, "    ", root)

    loose = [a for a in open_arks if a["slug"] not in claimed]
    if loose:
        if threads:
            print("\n%s loose arks (no thread)" % _c(YELLOW, "▸"))
        for a in loose:
            _ark_line(a, "  ", root)
    return 0


def all_sessions(text):
    """Every `### ` block under `## sessions`, newest first: date + done/why/next/head.
    Multiple done: lines in a block are joined. This is the raw activity log."""
    blocks, cur, in_sessions = [], None, False
    for raw in text.splitlines():
        m = HEADING_RE.match(raw)
        if m and len(m.group(1)) <= 2:
            if cur:
                blocks.append(cur)
                cur = None
            in_sessions = bool(SESSIONS_HEADING_RE.match(raw))
            continue
        if not in_sessions:
            continue
        if m:  # ### date subheading -> new block
            if cur:
                blocks.append(cur)
            dm = re.match(r"^#{3,6}\s+(.+)$", raw)
            cur = {"date": dm.group(1).strip() if dm else "?"}
            continue
        if cur is not None:
            fm = re.match(r"^\s*(done|why|next|head):\s*(.+)$", raw, re.IGNORECASE)
            if fm:
                k, v = fm.group(1).lower(), fm.group(2).strip()
                cur[k] = (cur[k] + "; " + v) if cur.get(k) else v
    if cur:
        blocks.append(cur)
    return blocks


def registered_projects(home):
    """Project roots from the append-only registry, deduped, only those still present."""
    path = os.path.join(home, "projects")
    if not os.path.isfile(path):
        return []
    seen, out = set(), []
    with open(path) as fh:
        for line in fh:
            p = line.strip()
            if not p or p in seen:
                continue
            if os.path.isdir(os.path.join(p, ".orca", "arks")):
                seen.add(p)
                out.append(p)
    return out


def cmd_report(args):
    """Cross-project activity log: what you did, where, when — rolled up from the
    dated session blocks of every registered project's arks. Derived on read."""
    home = meta_home()
    projects = registered_projects(home)
    root = find_repo_root(os.getcwd())
    is_meta = os.path.abspath(os.path.join(root, ".orca")) == os.path.abspath(home)
    if (not is_meta and os.path.isdir(os.path.join(root, ".orca", "arks"))
            and root not in projects):
        projects.append(root)

    cutoff = None
    if args.since:
        m = re.match(r"^(\d+)d$", args.since)
        if m:
            cutoff = time.strftime("%Y-%m-%d",
                                   time.localtime(time.time() - int(m.group(1)) * 86400))

    rows = []  # (date, project, thread, slug, done, next, blocker)
    for proj in projects:
        pname = os.path.basename(proj)
        for ark in _load_docs(os.path.join(proj, ".orca", "arks")):
            thread = ark["fields"].get("thread", "—")
            blk = has_blocker(ark)
            for b in all_sessions(ark["text"]):
                d = b.get("date", "?")
                if cutoff and re.match(r"^\d{4}-\d{2}-\d{2}$", d) and d < cutoff:
                    continue
                rows.append((d, pname, thread, ark["slug"],
                             b.get("done", ""), b.get("next", ""), blk))

    if not projects:
        print(_c(DIM, "report: no projects registered. run `orca init` in each project."))
        return 0
    rows.sort(key=lambda r: r[0], reverse=True)
    span = (" since %s" % args.since) if args.since else ""
    print(_c(DIM, "orca report  ·  %d project(s)%s" % (len(projects), span)))
    if not rows:
        print(_c(DIM, "  no session activity%s" % span))
        return 0
    last = None
    for date, pname, thread, slug, done, nxt, blk in rows:
        if date != last:
            print("\n%s %s" % (_c(YELLOW, "──"), date))
            last = date
        flag = _c(RED, " ⚠") if blk else ""
        print("  %s%s  %s" % (_c(DIM, "[%s]" % thread), flag,
                              "%s/%s" % (pname, slug)))
        if done:
            print("      %s %s" % (_c(GREEN, "done:"), done[:110]))
        if nxt:
            print("      %s %s" % (_c(DIM, "next:"), _c(DIM, nxt[:110])))
    return 0


def main(argv=None):
    p = argparse.ArgumentParser(prog="orca", description=__doc__,
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest="cmd")

    v = sub.add_parser("verify", help="verify a handoff's anchors against reality")
    v.add_argument("arkfile", nargs="?", help="ark file (default: freshest under .orca/arks/)")
    v.add_argument("--no-tests", action="store_true", help="skip re-running [test:] anchors")
    v.add_argument("--timeout", type=int, default=120, help="per-test timeout seconds")
    v.add_argument("--judge", action="store_true",
                   help="also ask a separate cheap model if each done: claim is grounded "
                        "in its evidence (pluggable via ORCA_JUDGE_CMD; off by default)")
    v.set_defaults(func=cmd_verify)

    sub.add_parser("init", help="scaffold meta-tier ~/.orca and project .orca").set_defaults(func=cmd_init)

    sub.add_parser("now", help="resume view: goal + open arks + where you stopped (computed on read)").set_defaults(func=cmd_now)

    r = sub.add_parser("report", help="cross-project activity log from dated session blocks")
    r.add_argument("--since", help="only blocks newer than e.g. 7d, 14d")
    r.set_defaults(func=cmd_report)

    d = sub.add_parser("decide", help="append a decision + why to .orca/decisions.md (append-only)")
    d.add_argument("text", nargs="+", help="the decision and its reason, e.g. \"per-axis collision — gives wall-slide for free\"")
    d.set_defaults(func=cmd_decide)

    g = sub.add_parser("gate", help="exit 1 + reason if the freshest active ark's handoff isn't verified (non-blocking warn)")
    g.add_argument("--timeout", type=int, default=120, help="per-test timeout seconds")
    g.set_defaults(func=cmd_gate)

    args = p.parse_args(argv)
    if not getattr(args, "func", None):
        p.print_help()
        return 0
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main())
