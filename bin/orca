#!/usr/bin/env python3
"""orca — lightweight session continuity for Claude Code.

Files are state. Views are derived on read. One writer per file. No locks,
no lifecycle flips, no scheduler, no shared mutable state.

The trust foundation is `orca verify`: a handoff is not faith-based prose, it
is claims + checkable anchors. If an anchor is fake, verify fails. Confabulated
continuity gets caught here instead of silently poisoning the next session.

Anchors (inline in handoff bullets):
  [file:PATH:LINE]   -> PATH exists and has >= LINE lines
  [commit:HASH]      -> HASH resolves to a commit in this repo
  [test:COMMAND]     -> COMMAND re-runs with exit 0 (skipped with --no-tests)

Usage:
  orca init                            scaffold meta-tier ~/.orca + project .orca
  orca verify [ARKFILE] [--no-tests]   check a handoff's anchors against reality
  orca day                             morning: Now threads + their Open arks
  orca glance                          midday: where work sits + blockers
  orca report                          evening: today's Trail + commits

Topology (all views derived on read, nothing derived is stored):
  ~/.orca/threads/<thread>.md   cross-project intent + goal (one writer)
  <project>/.orca/arks/<slug>.md   a thread of work: intent, done-when, handoff
Override the meta home with ORCA_HOME (used by tests).
"""
import argparse
import glob
import os
import re
import subprocess
import sys
import time

ANCHOR_RE = re.compile(r"\[(file|commit|test):([^\]]+)\]")
HANDOFF_HEADING_RE = re.compile(r"^#{1,6}\s+handoff\b", re.IGNORECASE)
BULLET_RE = re.compile(r"^\s*[-*]\s+\S")

GREEN, RED, YELLOW, DIM, RESET = "\033[32m", "\033[31m", "\033[33m", "\033[2m", "\033[0m"


def _c(color, text):
    return text if not sys.stdout.isatty() else color + text + RESET


def find_repo_root(start):
    """Nearest ancestor holding .orca/, else git toplevel, else start."""
    cur = os.path.abspath(start)
    while True:
        if os.path.isdir(os.path.join(cur, ".orca")):
            return cur
        parent = os.path.dirname(cur)
        if parent == cur:
            break
        cur = parent
    try:
        out = subprocess.run(
            ["git", "rev-parse", "--show-toplevel"],
            cwd=start, capture_output=True, text=True, check=True,
        )
        return out.stdout.strip()
    except (subprocess.CalledProcessError, FileNotFoundError):
        return os.path.abspath(start)


def default_arkfile(root):
    arks = os.path.join(root, ".orca", "arks")
    if not os.path.isdir(arks):
        return None
    cands = [
        os.path.join(arks, f)
        for f in os.listdir(arks)
        if f.endswith(".md")
    ]
    if not cands:
        return None
    # freshest by mtime; views are derived, so no stored "active" flag
    cands.sort(key=os.path.getmtime, reverse=True)
    return cands[0]


def check_file(payload, root):
    if ":" not in payload:
        return False, "no :LINE in anchor"
    path, _, line_s = payload.rpartition(":")
    try:
        line = int(line_s)
    except ValueError:
        return False, "line not an int: %r" % line_s
    abs_path = path if os.path.isabs(path) else os.path.join(root, path)
    if not os.path.isfile(abs_path):
        return False, "file not found: %s" % path
    with open(abs_path, "r", errors="replace") as fh:
        n = sum(1 for _ in fh)
    if line < 1 or line > n:
        return False, "line %d out of range (file has %d)" % (line, n)
    return True, "%s:%d ok" % (path, line)


def check_commit(payload, root):
    h = payload.strip()
    try:
        out = subprocess.run(
            ["git", "rev-parse", "--verify", "--quiet", h + "^{commit}"],
            cwd=root, capture_output=True, text=True,
        )
    except FileNotFoundError:
        return False, "git not available"
    if out.returncode != 0 or not out.stdout.strip():
        return False, "no such commit: %s" % h
    return True, "commit %s" % out.stdout.strip()[:12]


def check_test(payload, root, timeout):
    cmd = payload.strip()
    try:
        out = subprocess.run(
            cmd, cwd=root, shell=True, capture_output=True, text=True,
            timeout=timeout,
        )
    except subprocess.TimeoutExpired:
        return False, "timed out after %ss" % timeout
    if out.returncode != 0:
        tail = (out.stderr or out.stdout or "").strip().splitlines()
        tail = tail[-1] if tail else ""
        return False, "exit %d: %s" % (out.returncode, tail[:80])
    return True, "exit 0"


def bare_claims(text):
    """Handoff bullets with no anchor = unproven prose. Flag them."""
    flagged = []
    in_handoff = False
    for raw in text.splitlines():
        if raw.startswith("#"):
            in_handoff = bool(HANDOFF_HEADING_RE.match(raw))
            continue
        if in_handoff and BULLET_RE.match(raw) and not ANCHOR_RE.search(raw):
            flagged.append(raw.strip())
    return flagged


def cmd_verify(args):
    root = find_repo_root(os.getcwd())
    path = args.arkfile or default_arkfile(root)
    if not path:
        print(_c(RED, "verify: no ark file given and none under .orca/arks/"))
        return 2
    if not os.path.isfile(path):
        print(_c(RED, "verify: not a file: %s" % path))
        return 2

    with open(path, "r", errors="replace") as fh:
        text = fh.read()

    anchors = ANCHOR_RE.findall(text)
    rel = os.path.relpath(path, root)
    print(_c(DIM, "ark: %s  (root: %s)" % (rel, root)))

    if not anchors:
        print(_c(YELLOW, "no anchors found — handoff is unproven prose"))

    ok = True
    for kind, payload in anchors:
        if kind == "file":
            passed, msg = check_file(payload, root)
        elif kind == "commit":
            passed, msg = check_commit(payload, root)
        else:  # test
            if args.no_tests:
                print("  %s [test:%s] %s" % (_c(YELLOW, "SKIP"), payload, _c(DIM, "(--no-tests)")))
                continue
            passed, msg = check_test(payload, root, args.timeout)
        tag = _c(GREEN, " OK ") if passed else _c(RED, "FAIL")
        print("  %s [%s:%s] %s" % (tag, kind, payload, _c(DIM, msg)))
        ok = ok and passed

    bare = bare_claims(text)
    for b in bare:
        print("  %s %s" % (_c(YELLOW, "BARE"), _c(DIM, b[:90])))
    if bare:
        ok = False

    print(_c(GREEN, "verify: PASS") if ok else _c(RED, "verify: FAIL"))
    return 0 if ok else 1


# --- topology: meta-tier ~/.orca + project .orca, all derivation on read ---

FIELD_RE = re.compile(r"([A-Za-z][\w-]*):\s*(.*)$")


def meta_home():
    """Cross-project meta-tier. ORCA_HOME override keeps tests off real ~/.orca."""
    return os.environ.get("ORCA_HOME") or os.path.join(os.path.expanduser("~"), ".orca")


def parse_fields(text):
    """Leading `key: value` block (after the title heading, before first section)."""
    fields = {}
    for raw in text.splitlines():
        s = raw.strip()
        if s.startswith("#"):
            continue
        if not s:
            if fields:
                break
            continue
        m = FIELD_RE.match(s)
        if m:
            fields[m.group(1).lower()] = m.group(2).strip()
        elif fields:
            break
    return fields


def section_bullets(text, name):
    """Bullets under `## <name>`."""
    out, in_sec = [], False
    head = re.compile(r"^#{1,6}\s+" + re.escape(name) + r"\b", re.IGNORECASE)
    for raw in text.splitlines():
        if raw.startswith("#"):
            in_sec = bool(head.match(raw))
            continue
        if in_sec and BULLET_RE.match(raw):
            out.append(raw.strip().lstrip("-* ").strip())
    return out


def _load_docs(directory):
    docs = []
    for f in sorted(glob.glob(os.path.join(directory, "*.md"))):
        with open(f, "r", errors="replace") as fh:
            text = fh.read()
        docs.append({
            "slug": os.path.splitext(os.path.basename(f))[0],
            "path": f, "text": text, "fields": parse_fields(text),
            "mtime": os.path.getmtime(f),
        })
    docs.sort(key=lambda d: d["mtime"], reverse=True)  # freshest first
    return docs


def iter_arks(project_root):
    return _load_docs(os.path.join(project_root, ".orca", "arks"))


def iter_threads(home):
    return _load_docs(os.path.join(home, "threads"))


def is_open(ark):
    return ark["fields"].get("state", "active").lower() != "archived"


def has_blocker(ark):
    hay = ark["text"].lower()
    return "blocker" in hay or "blocked" in hay


def ago(ts):
    d = max(0, time.time() - ts)
    if d < 3600:
        return "%dm ago" % (d // 60)
    if d < 86400:
        return "%dh ago" % (d // 3600)
    return "%dd ago" % (d // 86400)


def cmd_init(args):
    home = meta_home()
    made = []
    seeds = [
        (os.path.join(home, "threads"), None),
        (os.path.join(home, "decisions.md"),
         "# decisions — cross-project (meta)\n\nAppend-only. Why, not what.\n"),
        (os.path.join(home, "trail-archive.md"),
         "# trail-archive — retired handoffs\n"),
    ]
    if not os.path.isdir(home):
        os.makedirs(home)
        made.append(home + "/")
    for path, content in seeds:
        if content is None:
            if not os.path.isdir(path):
                os.makedirs(path)
                made.append(path + "/")
        elif not os.path.exists(path):
            with open(path, "w") as fh:
                fh.write(content)
            made.append(path)
    if not os.path.isdir(os.path.join(home, ".git")):
        subprocess.run(["git", "init", "-q"], cwd=home)
        made.append(home + "/.git")

    root = find_repo_root(os.getcwd())
    pdir = os.path.join(root, ".orca")
    if not os.path.isdir(os.path.join(pdir, "arks")):
        os.makedirs(os.path.join(pdir, "arks"))
        made.append(os.path.join(pdir, "arks") + "/")
    pdec = os.path.join(pdir, "decisions.md")
    if not os.path.exists(pdec):
        with open(pdec, "w") as fh:
            fh.write("# decisions — %s\n\nWhy this repo's code is the way it is.\n"
                     % os.path.basename(root))
        made.append(pdec)

    if made:
        for m in made:
            print("  %s %s" % (_c(GREEN, "+"), m))
    else:
        print(_c(DIM, "already initialized (meta: %s)" % home))
    return 0


def cmd_day(args):
    """Morning: Now threads + their Open arks, distance-to-goal by freshness."""
    home = meta_home()
    root = find_repo_root(os.getcwd())
    threads = iter_threads(home)
    arks = iter_arks(root)
    open_arks = [a for a in arks if is_open(a)]

    print(_c(DIM, "orca day  ·  %s" % os.path.basename(root)))
    if threads:
        claimed = set()
        for t in threads:
            goal = t["fields"].get("goal", "—")
            print("\n%s %s  %s" % (_c(YELLOW, "▸"), t["slug"], _c(DIM, ago(t["mtime"]))))
            print("    goal: %s" % goal)
            mine = [a for a in open_arks if a["fields"].get("thread", "") == t["slug"]]
            for a in mine:
                claimed.add(a["slug"])
                print("    · %s  %s  %s"
                      % (a["slug"], _c(DIM, "done-when: " + a["fields"].get("done-when", "—")),
                         _c(DIM, ago(a["mtime"]))))
        loose = [a for a in open_arks if a["slug"] not in claimed]
        if loose:
            print("\n%s loose arks (no thread)" % _c(YELLOW, "▸"))
            for a in loose:
                print("    · %s  %s" % (a["slug"], _c(DIM, ago(a["mtime"]))))
    else:
        if not open_arks:
            print(_c(DIM, "  nothing open. `orca init` then add .orca/arks/<slug>.md"))
        for a in open_arks:
            print("  · %s  %s  %s"
                  % (a["slug"], _c(DIM, "done-when: " + a["fields"].get("done-when", "—")),
                     _c(DIM, ago(a["mtime"]))))
    return 0


def cmd_glance(args):
    """Midday: where the work sits + what blocks it."""
    root = find_repo_root(os.getcwd())
    open_arks = [a for a in iter_arks(root) if is_open(a)]
    print(_c(DIM, "orca glance  ·  %s" % os.path.basename(root)))
    if not open_arks:
        print(_c(DIM, "  no open arks"))
        return 0
    for a in open_arks:
        hand = section_bullets(a["text"], "handoff")
        last = hand[-1] if hand else _c(DIM, "(no handoff yet)")
        flag = _c(RED, " ⚠ blocker") if has_blocker(a) else ""
        print("  · %s%s\n      %s" % (a["slug"], flag, last))
    return 0


def cmd_report(args):
    """Evening: today's Trail (handoffs touched today) + archived + commits."""
    root = find_repo_root(os.getcwd())
    arks = iter_arks(root)
    today = time.strftime("%Y-%m-%d", time.localtime())
    print(_c(DIM, "orca report  ·  %s  ·  %s" % (os.path.basename(root), today)))

    fresh = [a for a in arks
             if time.strftime("%Y-%m-%d", time.localtime(a["mtime"])) == today]
    print("\n%s Trail (touched today)" % _c(YELLOW, "▸"))
    if not fresh:
        print(_c(DIM, "  —"))
    for a in fresh:
        for b in section_bullets(a["text"], "handoff"):
            print("  · [%s] %s" % (a["slug"], b))

    archived = [a for a in arks if not is_open(a)]
    if archived:
        print("\n%s archived" % _c(YELLOW, "▸"))
        for a in archived:
            print("  · %s" % a["slug"])

    print("\n%s commits today" % _c(YELLOW, "▸"))
    out = subprocess.run(
        ["git", "log", "--oneline", "--since=midnight"],
        cwd=root, capture_output=True, text=True,
    )
    body = out.stdout.strip()
    print(("  " + body.replace("\n", "\n  ")) if body else _c(DIM, "  —"))
    return 0


def main(argv=None):
    p = argparse.ArgumentParser(prog="orca", description=__doc__,
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest="cmd")

    v = sub.add_parser("verify", help="verify a handoff's anchors against reality")
    v.add_argument("arkfile", nargs="?", help="ark file (default: freshest under .orca/arks/)")
    v.add_argument("--no-tests", action="store_true", help="skip re-running [test:] anchors")
    v.add_argument("--timeout", type=int, default=120, help="per-test timeout seconds")
    v.set_defaults(func=cmd_verify)

    sub.add_parser("init", help="scaffold meta-tier ~/.orca and project .orca").set_defaults(func=cmd_init)

    views = {"day": cmd_day, "glance": cmd_glance, "report": cmd_report}
    for name, fn in views.items():
        sub.add_parser(name, help="derived view (computed on read)").set_defaults(func=fn)

    args = p.parse_args(argv)
    if not getattr(args, "func", None):
        p.print_help()
        return 0
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main())
